# ---- Your app ----
APP_URL=https://your-app.vercel.app          # where the web app is hosted (no trailing slash)
LINK_SECRET=change-me-long-random-string     # signs the Accept/Reject links in alert emails
CRON_SECRET=change-me-another-random-string  # protects the every-minute dispatcher

# ---- Supabase (database, logins, file storage) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...                     # public key, safe in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...             # SECRET, server only

# ---- ElevenLabs (voice cloning, AI voice, the conversation, outbound calls) ----
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_AGENT_ID=agent_...                # printed by: npm run setup:elevenlabs
ELEVENLABS_PHONE_NUMBER_ID=phnum_...         # printed by the setup script after importing your SIP number
ELEVENLABS_WEBHOOK_SECRET=wsec_...           # printed by the setup script
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5       # multilingual, supports English, Chinese and Malay
DEFAULT_AI_VOICE_ID=cjVigY5qzO86Huf0OWal     # used when an agent picks "AI voice"
# Voices agents can choose from (id|label, separated by ;) - copy voice IDs from your ElevenLabs Voice Library
AI_VOICES=cjVigY5qzO86Huf0OWal|Female - warm and clear
MAX_CONCURRENT_CALLS=5

# ---- Your fixed Malaysian number (SIP trunk from your provider) ----
SIP_PHONE_NUMBER=+60327884410                # E.164, shown to leads as caller ID
SIP_ADDRESS=sip.yourprovider.com             # hostname only, no "sip:"
SIP_USERNAME=
SIP_PASSWORD=
SIP_TRANSPORT=auto                           # auto | udp | tcp | tls

# ---- Claude (reads sales-kit PDFs and lead photos) ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# ---- Gmail (alerts go to agents only) ----
GMAIL_USER=sembang.alerts@gmail.com          # the Gmail account that sends alerts
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx       # Google account > Security > App passwords
